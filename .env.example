DB_HOST=localhost
DB_NAME=facturation
DB_USER=root
DB_PASS=

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/facturation
# Hôtes autorisés dans les liens envoyés par email (en plus de celui d'APP_URL et de localhost),
# séparés par des virgules — ex. le domaine d'un tunnel ngrok ou l'IP locale du PC.
APP_TRUSTED_HOSTS=

# --- Configuration Email (SMTP) ---
# En développement local, le fichier .env (pas celui-ci) pointe par défaut vers Mailpit,
# un attrape-mails lancé par docker-compose (aucun vrai envoi, consultable sur
# http://localhost:8025) — inutile de configurer un compte SMTP réel pour développer/démontrer
# en local. Ci-dessous, les valeurs à utiliser pour un vrai envoi (production).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=votre.email@gmail.com
# Entre guillemets : les mots de passe d'application Gmail contiennent des espaces
MAIL_PASSWORD="votre_mot_de_passe_application"
MAIL_FROM=votre.email@gmail.com
MAIL_FROM_NAME=FactuPro

# --- Variables Docker (utilisées par docker-compose.yml) ---
DOCKER_DB_HOST=db
DOCKER_DB_NAME=facturation
DOCKER_DB_USER=root
DOCKER_DB_PASS=changeme
# SMTP vu depuis le conteneur app — par défaut (non défini) : Mailpit (mailpit:1025, sans TLS).
# Pour un vrai envoi sous Docker, reprendre les valeurs MAIL_HOST/PORT/ENCRYPTION ci-dessus.
# DOCKER_MAIL_HOST=smtp.gmail.com
# DOCKER_MAIL_PORT=587
# DOCKER_MAIL_ENCRYPTION=tls
